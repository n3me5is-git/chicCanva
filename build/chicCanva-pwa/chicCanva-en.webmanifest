{
  "id": "./",
  "name": "chicCanva · Small ideas, big projects",
  "short_name": "chicCanva",
  "description": "A graphic editor with AI tools for worksheets, posters, illustrations, and creative educational projects.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f3f5f1",
  "theme_color": "#298879",
  "categories": ["education", "graphics", "productivity"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{
        "name": "files",
        "accept": ["application/pdf", ".pdf", "application/json", ".json", "image/png", ".png", "image/jpeg", ".jpg", ".jpeg", "image/webp", ".webp", "image/gif", ".gif", "image/bmp", ".bmp", "image/svg+xml", ".svg"]
      }]
    }
  },
  "icons": [
    {"src": "chiccanva-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "chiccanva-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ]
}


