@echo off
setlocal
cd /d "%~dp0"
title chicCanva - Server locale
set "PORT=8000"
set "HTML=chicCanva.html"
echo chicCanva: http://localhost:%PORT%/
echo Chiudi questa finestra per fermare il server.
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
 "$root=Get-Location; $file=Join-Path $root '%HTML%'; if(!(Test-Path -LiteralPath $file)){Write-Host 'HTML non trovato'; exit 1};" ^
 "function Test-PublicUri([Uri]$uri){if($uri.Scheme -notin @('http','https') -or !$uri.Host -or $uri.UserInfo){return $false};if($uri.Host -eq 'localhost' -or $uri.Host.EndsWith('.local')){return $false};try{$ips=[Net.Dns]::GetHostAddresses($uri.DnsSafeHost)}catch{return $false};if(!$ips.Count){return $false};foreach($ip in $ips){if([Net.IPAddress]::IsLoopback($ip)){return $false};$b=$ip.GetAddressBytes();if($b.Length -eq 4){if($b[0] -eq 0 -or $b[0] -eq 10 -or $b[0] -eq 127 -or ($b[0] -eq 100 -and $b[1] -ge 64 -and $b[1] -le 127) -or ($b[0] -eq 169 -and $b[1] -eq 254) -or ($b[0] -eq 172 -and $b[1] -ge 16 -and $b[1] -le 31) -or ($b[0] -eq 192 -and $b[1] -eq 168) -or $b[0] -ge 224){return $false}}else{if($ip.IsIPv6LinkLocal -or $ip.IsIPv6SiteLocal -or (($b[0] -band 254) -eq 252)){return $false}}};return $true};" ^
 "$listener=New-Object System.Net.HttpListener; $listener.Prefixes.Add('http://localhost:%PORT%/');" ^
 "try{$listener.Start()}catch{Write-Host 'Porta occupata o non disponibile. Chiudi il vecchio server e riprova.'; exit 1};" ^
 "Start-Process 'http://localhost:%PORT%/';" ^
 "try{while($listener.IsListening){$ctx=$listener.GetContext(); $res=$ctx.Response;" ^
 "try{if($ctx.Request.HttpMethod -ne 'GET'){$res.StatusCode=405}elseif($ctx.Request.Url.LocalPath -in @('/','/index.html','/%HTML%')){$bytes=[IO.File]::ReadAllBytes($file);$res.ContentType='text/html; charset=utf-8';$res.Headers['Cache-Control']='no-cache';$res.ContentLength64=$bytes.Length;$res.OutputStream.Write($bytes,0,$bytes.Length)}elseif($ctx.Request.Url.LocalPath -eq '/__chiccanva_openclipart_search'){" ^
 "$site=$ctx.Request.Headers['Sec-Fetch-Site'];$msg=$null;if($site -and $site -ne 'same-origin'){$res.StatusCode=403;$msg='Richiesta non consentita'}else{$query=([string]$ctx.Request.QueryString['query']).Trim();$page=1;[void][int]::TryParse($ctx.Request.QueryString['p'],[ref]$page);$page=[Math]::Max(1,[Math]::Min(500,$page));if(!$query -or $query.Length -gt 120){$res.StatusCode=400;$msg='Parola chiave non valida'}else{try{$encoded=[Uri]::EscapeDataString($query);$uri=[Uri]('https://openclipart.org/search/?p='+$page+'&query='+$encoded);$req=[Net.HttpWebRequest]::Create($uri);$req.UserAgent='Mozilla/5.0 chicCanva/1.0';$req.Accept='text/html';$req.AutomaticDecompression=[Net.DecompressionMethods]::GZip -bor [Net.DecompressionMethods]::Deflate;$req.Timeout=20000;$req.ReadWriteTimeout=20000;$req.MaximumAutomaticRedirections=3;$up=$req.GetResponse();if($up.ResponseUri.Host -ne 'openclipart.org'){throw 'Redirect Openclipart non valido'};$input=$up.GetResponseStream();$mem=New-Object IO.MemoryStream;$buffer=New-Object byte[] 65536;while(($read=$input.Read($buffer,0,$buffer.Length)) -gt 0){$mem.Write($buffer,0,$read);if($mem.Length -gt 2097152){throw 'Risposta Openclipart troppo grande'}};$bytes=$mem.ToArray();$res.ContentType='text/html; charset=utf-8';$res.Headers['Cache-Control']='no-store';$res.ContentLength64=$bytes.Length;$res.OutputStream.Write($bytes,0,$bytes.Length)}catch{$res.StatusCode=502;$msg=$_.Exception.Message}finally{if($input){$input.Dispose()};if($up){$up.Dispose()};if($mem){$mem.Dispose()}}};if($msg){$bytes=[Text.Encoding]::UTF8.GetBytes($msg);$res.ContentType='text/plain; charset=utf-8';$res.ContentLength64=$bytes.Length;$res.OutputStream.Write($bytes,0,$bytes.Length)}}}elseif($ctx.Request.Url.LocalPath -eq '/__chiccanva_image_proxy'){" ^
 "$site=$ctx.Request.Headers['Sec-Fetch-Site'];if($site -and $site -ne 'same-origin'){$res.StatusCode=403;$msg='Richiesta non consentita'}else{$raw=$ctx.Request.QueryString['url'];$uri=$null;if(![Uri]::TryCreate($raw,[UriKind]::Absolute,[ref]$uri) -or !(Test-PublicUri $uri)){$res.StatusCode=400;$msg='URL non valido o indirizzo locale non consentito'}else{try{$req=[Net.HttpWebRequest]::Create($uri);$req.UserAgent='chicCanva/1.0';$req.Timeout=20000;$req.ReadWriteTimeout=20000;$req.MaximumAutomaticRedirections=5;$up=$req.GetResponse();if(!(Test-PublicUri $up.ResponseUri)){throw 'Redirect verso un indirizzo non consentito'};$type=([string]$up.ContentType).Split(';')[0];if(!$type.StartsWith('image/')){throw 'Il link non restituisce una immagine'};if($up.ContentLength -gt 12582912){throw 'Immagine troppo grande: massimo 12 MB'};$input=$up.GetResponseStream();$mem=New-Object IO.MemoryStream;$buffer=New-Object byte[] 65536;while(($read=$input.Read($buffer,0,$buffer.Length)) -gt 0){$mem.Write($buffer,0,$read);if($mem.Length -gt 12582912){throw 'Immagine troppo grande: massimo 12 MB'}};$bytes=$mem.ToArray();$res.ContentType=$type;$res.Headers['Cache-Control']='no-store';$res.ContentLength64=$bytes.Length;$res.OutputStream.Write($bytes,0,$bytes.Length)}catch{$res.StatusCode=502;$msg=$_.Exception.Message}finally{if($input){$input.Dispose()};if($up){$up.Dispose()};if($mem){$mem.Dispose()}}}};if($msg){$bytes=[Text.Encoding]::UTF8.GetBytes($msg);$res.ContentType='text/plain; charset=utf-8';$res.ContentLength64=$bytes.Length;$res.OutputStream.Write($bytes,0,$bytes.Length)}}else{$res.StatusCode=404}}finally{$res.Close()}}}finally{$listener.Stop()}"
pause
endlocal
